---
import SiteLayout from '../layouts/SiteLayout.astro';
import Intro from '../components/Intro.astro';
import ContactLinks from '../components/ContactLinks.astro';
import PortfolioOverview from '../components/PortfolioOverview.astro';
import LocalWriteupList from '../components/LocalWriteupList.astro';
import portfolio from '../data/portfolio-content.json';
import { sitePath } from '../lib/paths';
---
<SiteLayout title={portfolio.name} description={portfolio.intro}>
  <Intro />
  <section id="about" class="home-section section-block" aria-labelledby="about-heading">
    <div class="page-shell">
      <div class="panel about-panel">
        <h2 id="about-heading">About Me</h2>
        <ul class="about-facts">
          {portfolio.aboutFacts.map((fact) => <li>{fact}</li>)}
        </ul>
        <p class="interests">{portfolio.interests}</p>
        <ContactLinks />
      </div>
    </div>
  </section>

  <section id="now" class="home-section section-block" aria-labelledby="now-heading">
    <div class="page-shell section-split">
      <h2 id="now-heading">What I'm Doing</h2>
      <div>
        <ul class="now-list">{portfolio.now.map((activity) => <li>{activity}</li>)}</ul>
        <p class="muted">Currently learning: {portfolio.skills.currentlyLearning.join(', ')}.</p>
        <p class="availability-note">{portfolio.internshipNote}</p>
      </div>
    </div>
  </section>

  <section id="portfolio" class="home-section section-block" aria-labelledby="portfolio-heading">
    <div class="page-shell">
      <PortfolioOverview homepage />
    </div>
  </section>

  <section id="writeups" class="home-section section-block" aria-labelledby="writeups-heading">
    <div class="page-shell">
      <div class="section-heading"><h2 id="writeups-heading">Write-ups</h2><a class="text-link" href={sitePath('writeups/')}>View write-ups</a></div>
      <p class="section-lead">{portfolio.writingNotice}</p>
      <LocalWriteupList headingLevel={3} />
    </div>
  </section>

  <section id="contact" class="home-section section-block" aria-labelledby="contact-heading">
    <div class="page-shell">
      <div class="section-heading"><h2 id="contact-heading">Contact</h2><a class="button button-primary" href={sitePath('contact/')}>Contact me</a></div>
      <p class="section-lead">Seeking opportunities in {portfolio.preferredWorkArea}.</p>
      <ContactLinks />
    </div>
  </section>
</SiteLayout>
