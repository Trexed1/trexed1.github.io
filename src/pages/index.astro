---
import Header from '../components/Header.astro';
import CopyButton from '../components/CopyButton.astro';
import ProjectRow from '../components/ProjectRow.astro';
import portfolio from '../data/portfolio-content.json';
import '../styles/global.css';

const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
const resumeUrl = base + portfolio.resume.file;
const skillGroups = [
  { label: 'Languages', values: portfolio.skills.languages },
  { label: 'Systems', values: portfolio.skills.systems },
  { label: 'Tools', values: portfolio.skills.tools },
  { label: 'Currently learning', values: portfolio.skills.currentlyLearning },
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta
      name="description"
      content={portfolio.intro}
    />
    <title>{portfolio.name}</title>
  </head>
  <body>
    <Header />

    <main id="top" class="page-shell">
      <div class="intro">
        <p class="eyebrow">{portfolio.location}</p>
        <h1>{portfolio.name}</h1>
        <p class="intro-text">{portfolio.intro}</p>
        <ul class="inline-links" aria-label="Professional resources">
          <li><a class="text-link" href={resumeUrl} download>Download résumé (PDF)</a></li>
          <li><a class="text-link" href={portfolio.contact.github}>GitHub</a></li>
          <li><a class="text-link" href={portfolio.contact.linkedin}>LinkedIn</a></li>
        </ul>
      </div>

      <section id="about" aria-labelledby="about-title">
        <div class="section-heading">
          <p class="section-number">01 / About</p>
          <h2 id="about-title">About</h2>
        </div>
        <div class="section-content prose">
          {portfolio.about.map((paragraph) => <p>{paragraph}</p>)}
          <p class="current-focus">{portfolio.currentFocus}</p>

          <h3 class="group-heading">Skills</h3>
          <dl class="skills-list">
            {skillGroups.map((group) => (
              <div>
                <dt>{group.label}</dt>
                <dd>{group.values.join(', ')}</dd>
              </div>
            ))}
          </dl>
        </div>
      </section>

      <section id="experience" aria-labelledby="experience-title">
        <div class="section-heading">
          <p class="section-number">02 / Experience</p>
          <h2 id="experience-title">Experience</h2>
        </div>
        <div class="section-content">
          <div class="content-group">
            <h3 class="group-heading">Education</h3>
            <article class="content-entry">
              <h4>{portfolio.education.school}</h4>
              <p>{portfolio.education.degree}</p>
              <p class="entry-meta">
                Expected {portfolio.education.expectedGraduation} · GPA: {portfolio.education.gpa}
              </p>
              <p>{portfolio.education.minors}</p>
              <p class="coursework">Relevant coursework: {portfolio.education.coursework.join('; ')}</p>
            </article>
          </div>

          <div class="content-group">
            <h3 class="group-heading">Work</h3>
            {portfolio.experience.map((job) => (
              <article class="content-entry">
                <h4>{job.role}</h4>
                <p class="entry-meta">{job.organization} · {job.date}</p>
                <p>{job.description}</p>
              </article>
            ))}
          </div>

          <div class="content-group">
            <h3 class="group-heading">Activities</h3>
            {portfolio.activities.map((activity) => (
              <article class="content-entry">
                <h4>{activity.title}</h4>
                <p class="entry-meta">
                  {[activity.organization, activity.date, activity.status].filter(Boolean).join(' · ')}
                </p>
                <p>{activity.description}</p>
              </article>
            ))}
          </div>

          <div class="content-group">
            <h3 class="group-heading">Training and exam preparation</h3>
            <ul class="training-list">
              {portfolio.training.map((course) => (
                <li>
                  <span>{course.name}</span>
                  <span class="entry-meta">{course.status}</span>
                </li>
              ))}
            </ul>
          </div>
        </div>
      </section>

      <section id="projects" aria-labelledby="projects-title">
        <div class="section-heading">
          <p class="section-number">03 / Projects</p>
          <h2 id="projects-title">Projects</h2>
        </div>
        <div class="section-content">
          {portfolio.projects.map((project) => <ProjectRow project={project} />)}
        </div>
      </section>

      <section id="writing" aria-labelledby="writing-title">
        <div class="section-heading">
          <p class="section-number">04 / Writing</p>
          <h2 id="writing-title">Writing</h2>
        </div>
        <div class="section-content">
          {portfolio.writing.length === 0 && <p class="empty-note">No published writeups yet.</p>}
        </div>
      </section>

      <section id="contact" aria-labelledby="contact-title">
        <div class="section-heading">
          <p class="section-number">05 / Contact</p>
          <h2 id="contact-title">Contact</h2>
        </div>
        <div class="section-content prose">
          <p>Based in {portfolio.location}. Interested in opportunities in {portfolio.preferredWorkArea}.</p>
          <dl class="contact-list">
            <div>
              <dt>Email</dt>
              <dd>
                <a class="text-link" href={'mailto:' + portfolio.contact.email}>{portfolio.contact.email}</a>
                <CopyButton value={portfolio.contact.email} label="Copy email" />
              </dd>
            </div>
            <div>
              <dt>Phone</dt>
              <dd><a class="text-link" href={portfolio.contact.phoneHref}>{portfolio.contact.phoneDisplay}</a></dd>
            </div>
            <div>
              <dt>GitHub</dt>
              <dd><a class="text-link" href={portfolio.contact.github}>Trexed1</a></dd>
            </div>
            <div>
              <dt>LinkedIn</dt>
              <dd><a class="text-link" href={portfolio.contact.linkedin}>{portfolio.name}</a></dd>
            </div>
            <div>
              <dt>Discord</dt>
              <dd>
                <span>{portfolio.contact.discord}</span>
                <CopyButton value={portfolio.contact.discord} label="Copy Discord" />
              </dd>
            </div>
          </dl>
          <a class="text-link" href={resumeUrl} download>Download résumé (PDF)</a>
        </div>
      </section>
    </main>

    <footer class="site-footer">
      <div class="page-shell">{portfolio.name}</div>
    </footer>
  </body>
</html>
