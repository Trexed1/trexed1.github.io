---
import SiteLayout from '../../layouts/SiteLayout.astro';
import ContactLinks from '../../components/ContactLinks.astro';
import ContactForm from '../../components/ContactForm.astro';
import portfolio from '../../data/portfolio-content.json';
const mapsUrl = 'https://www.google.com/maps/search/?api=1&query=' + encodeURIComponent('San Jose, CA');
---
<SiteLayout title="Contact" description="Contact Tyler Rex by email, phone, LinkedIn, or Discord, or prepare an email draft.">
  <div class="page-shell page-content">
    <header class="page-heading">
      <p class="eyebrow">Get in touch</p>
      <h1>Contact</h1>
      <p>Find my contact details below, or prepare a message in your email app.</p>
    </header>
    <div class="panel contact-overview"><ContactLinks /></div>
    <div class="contact-grid">
      <ContactForm />
      <section class="panel location-panel" aria-labelledby="location-heading">
        <h2 id="location-heading">Opportunity area</h2>
        <p>Seeking opportunities in {portfolio.preferredWorkArea}.</p>
        <a class="text-link" href={mapsUrl}>Explore San Jose in Maps</a>
      </section>
    </div>
  </div>
</SiteLayout>
