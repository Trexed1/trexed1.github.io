---
import { sitePath } from '../lib/paths';
interface Props {
  project: { id: string; name: string; kind: string; status: string; summary: string; technologies: string[]; previewTechnologies?: string[]; path?: string; toolsLabel?: string; };
  headingLevel?: 3 | 4;
}
const { project, headingLevel = 3 } = Astro.props;
const Heading = headingLevel === 4 ? 'h4' : 'h3';
---
<article class="project-row" aria-labelledby={project.id + '-title'}>
  <p class="eyebrow">{project.kind}{project.status !== project.kind && ' · ' + project.status}</p>
  <Heading id={project.id + '-title'}>{project.name}</Heading>
  <p>{project.summary}</p>
  <p class="entry-meta">{project.toolsLabel ?? 'Tools'}: {(project.previewTechnologies ?? project.technologies).join(', ')}</p>
  {project.path && <a class="text-link" href={sitePath(project.path)}>View project</a>}
</article>
