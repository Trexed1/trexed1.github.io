---
import portfolio from '../data/portfolio-content.json';
import CopyButton from './CopyButton.astro';
---
<section class="panel contact-form-panel" aria-labelledby="draft-heading">
  <h2 id="draft-heading">Write a message</h2>
  <p id="draft-help">Opens your email app with a draft. Send it from there.</p>
  <form action={'mailto:' + portfolio.contact.email} method="get" data-email-draft data-recipient={portfolio.contact.email} aria-describedby="draft-help">
    <div class="form-row">
      <div class="field">
        <label for="sender-name">Name</label>
        <input id="sender-name" name="name" autocomplete="name" required maxlength="100" />
      </div>
      <div class="field">
        <label for="sender-email">Email</label>
        <input id="sender-email" name="email" type="email" autocomplete="email" required maxlength="254" />
      </div>
    </div>
    <div class="field">
      <label for="draft-subject">Subject <span class="muted">(optional)</span></label>
      <input id="draft-subject" name="subject" maxlength="150" />
    </div>
    <div class="field">
      <label for="draft-message">Message</label>
      <textarea id="draft-message" name="message" rows="7" maxlength="2000" required aria-describedby="message-help"></textarea>
      <span id="message-help" class="field-help">Up to 2,000 characters.</span>
    </div>
    <button class="button button-primary" type="submit" data-draft-submit disabled>Open email draft</button>
    <p class="form-status" data-draft-status role="status"></p>
    <noscript><p>JavaScript is needed to prepare the draft here. Use the direct email link below instead.</p></noscript>
  </form>
  <div class="email-fallback">
    <a href={'mailto:' + portfolio.contact.email}>{portfolio.contact.email}</a>
    <CopyButton value={portfolio.contact.email} label="Copy email" />
  </div>
</section>
<script>
  const form = document.querySelector<HTMLFormElement>('[data-email-draft]');
  const submit = form?.querySelector<HTMLButtonElement>('[data-draft-submit]');
  const status = form?.querySelector<HTMLElement>('[data-draft-status]');
  if (form && submit && status) {
    const name = form.elements.namedItem('name') as HTMLInputElement;
    const message = form.elements.namedItem('message') as HTMLTextAreaElement;
    submit.disabled = false;
    form.addEventListener('input', () => {
      name.setCustomValidity('');
      message.setCustomValidity('');
      status.textContent = '';
    });
    form.addEventListener('submit', (event) => {
      event.preventDefault();
      name.setCustomValidity(name.value.trim() ? '' : 'Enter your name.');
      message.setCustomValidity(message.value.trim() ? '' : 'Enter a message.');
      if (!form.reportValidity()) return;
      const values = new FormData(form);
      const sender = String(values.get('name') ?? '').trim();
      const email = String(values.get('email') ?? '').trim();
      const subject = String(values.get('subject') ?? '').trim() || 'Website contact';
      const body = ['Name: ' + sender, 'Email: ' + email, '', String(values.get('message') ?? '').trim()].join('\n');
      const url = 'mailto:' + form.dataset.recipient + '?subject=' + encodeURIComponent(subject) + '&body=' + encodeURIComponent(body);
      try {
        window.location.href = url;
        status.textContent = 'Your email app was asked to open a draft. If nothing opens, use the email link or copy the address.';
      } catch {
        status.textContent = 'Could not open a draft. Use the direct email link or copy the address.';
      }
    });
  }
</script>
