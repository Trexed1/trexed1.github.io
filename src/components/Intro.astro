---
import portfolio from '../data/portfolio-content.json';
import Icon from './Icon.astro';
import { sitePath } from '../lib/paths';
---
<section id="top" class="intro home-section" aria-labelledby="intro-title">
  <div class="page-shell intro-inner">
    <h1 id="intro-title" class="intro-name" data-type-name={portfolio.name}>
      <span class="visually-hidden">{portfolio.name}</span>
      <span class="name-stage" aria-hidden="true">
        <span class="name-placeholder">{portfolio.name}</span>
        <span class="name-typed">{portfolio.name}</span>
      </span>
    </h1>
    <p class="intro-subtitle">{portfolio.role}</p>
    <div class="intro-actions">
      <a class="button button-primary" href={sitePath('portfolio/')}>Portfolio</a>
      <a class="button button-secondary" href={sitePath('contact/')}>Contact</a>
    </div>
    <ul class="resource-links intro-resources" aria-label="Professional resources">
      <li><a href={sitePath(portfolio.resume.file)} download>Resume</a></li>
      <li><a href={portfolio.contact.github}><Icon name="github" />GitHub</a></li>
      <li><a href={portfolio.contact.linkedin}><Icon name="linkedin" />LinkedIn</a></li>
    </ul>
    <a class="scroll-prompt" href="#about">Scroll to About</a>
  </div>
</section>
<script>
  const heading = document.querySelector<HTMLElement>('[data-type-name]');
  const visual = heading?.querySelector<HTMLElement>('.name-typed');
  const fullName = heading?.dataset.typeName;
  if (heading && visual && fullName && window.matchMedia) {
    const motion = window.matchMedia('(prefers-reduced-motion: reduce)');
    let timer = 0;
    let index = 0;
    const finish = () => {
      window.clearTimeout(timer);
      visual.textContent = fullName;
      heading.classList.remove('is-typing');
      motion.removeEventListener('change', onMotionChange);
    };
    const onMotionChange = () => { if (motion.matches) finish(); };
    const typeNext = () => {
      index += 1;
      visual.textContent = fullName.slice(0, index);
      if (index < fullName.length) timer = window.setTimeout(typeNext, 90);
      else timer = window.setTimeout(finish, 80);
    };
    if (!motion.matches) {
      visual.textContent = '';
      heading.classList.add('is-typing');
      motion.addEventListener('change', onMotionChange);
      timer = window.setTimeout(typeNext, 180);
    }
  }
</script>
