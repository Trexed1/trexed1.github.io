---
import Header from '../components/Header.astro';
import portfolio from '../data/portfolio-content.json';
import { sitePath } from '../lib/paths';
import '../styles/global.css';
interface Props { title: string; description: string; noindex?: boolean; }
const { title, description, noindex = false } = Astro.props;
const pageTitle = title === portfolio.name ? title : title + ' | ' + portfolio.name;
const shareImage = new URL(sitePath('images/tyler-rex-share.png'), Astro.site).href;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <link rel="icon" href={sitePath('favicon.ico')} sizes="32x32" />
    <link rel="icon" href={sitePath('favicon.svg')} type="image/svg+xml" />
    <link rel="apple-touch-icon" href={sitePath('apple-touch-icon.png')} sizes="180x180" />
    {!noindex && <>
      <meta property="og:type" content="website" />
      <meta property="og:site_name" content={portfolio.name} />
      <meta property="og:title" content={pageTitle} />
      <meta property="og:description" content={description} />
      <meta property="og:image" content={shareImage} />
      <meta property="og:image:width" content="1200" />
      <meta property="og:image:height" content="630" />
      <meta property="og:image:alt" content="TR monogram for Tyler Rex on a charcoal background" />
      <meta name="twitter:card" content="summary_large_image" />
      <meta name="twitter:title" content={pageTitle} />
      <meta name="twitter:description" content={description} />
      <meta name="twitter:image" content={shareImage} />
      <meta name="twitter:image:alt" content="TR monogram for Tyler Rex on a charcoal background" />
    </>}
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    <title>{pageTitle}</title>
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <Header />
    <main id="main"><slot /></main>
    <footer class="site-footer">
      <div class="page-shell footer-inner">
        <span>{portfolio.name} · Seeking opportunities in {portfolio.preferredWorkArea}</span>
        <div class="footer-links">
          <a href={sitePath(portfolio.resume.file)} download>Resume</a>
          <a href="https://github.com/Trexed1/trexed1.github.io">Site source</a>
        </div>
      </div>
    </footer>
  </body>
</html>
